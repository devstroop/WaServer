# Production Environment Variables
#
# Copy this file to .env and customize for your production environment

# Application
ENVIRONMENT=production
RUST_LOG=warn

# WhatsApp Engine Configuration
WHATSAPP_API_TOKEN=your-secure-production-token-change-this
WHATSAPP__SERVER__HOST=0.0.0.0
WHATSAPP__SERVER__PORT=3000

# Browser Configuration
WHATSAPP__BROWSER__HEADLESS=true
WHATSAPP__BROWSER__TIMEOUT_MS=30000

# Security
WHATSAPP__LIMITS__MAX_CONCURRENT_REQUESTS=50
WHATSAPP__LIMITS__REQUEST_TIMEOUT_MS=30000
WHATSAPP__LIMITS__MAX_UPLOAD_SIZE=10485760

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Grafana
GRAFANA_PASSWORD=secure-grafana-password-change-this

# SSL (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Domain (replace with your actual domain)
DOMAIN_NAME=whatsapp-engine.yourdomain.com

# Resource Limits
MEMORY_LIMIT=1G
CPU_LIMIT=1.0
MEMORY_RESERVATION=512M
CPU_RESERVATION=0.5
