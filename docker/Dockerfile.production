# WhatsApp Engine - Production Dockerfile
#
# Multi-stage build for optimized production image

# Build stage
FROM rust:1.75-slim as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy Cargo files
COPY Cargo.toml Cargo.lock ./

# Create dummy source files to cache dependencies
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    echo "" > src/lib.rs

# Build dependencies (this layer will be cached)
RUN cargo build --release --features api-server
RUN rm -rf src

# Copy source code
COPY src ./src
COPY config ./config

# Build the application
RUN cargo build --release --features api-server

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r whatsapp && useradd -r -g whatsapp whatsapp

# Create app directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/whatsapp-server /usr/local/bin/whatsapp-server

# Copy configuration
COPY --from=builder /app/config ./config

# Set up chromium for non-root user
RUN mkdir -p /home/whatsapp/.cache/chromium && \
    chown -R whatsapp:whatsapp /home/whatsapp && \
    chown -R whatsapp:whatsapp /app

# Switch to non-root user
USER whatsapp

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Set environment variables
ENV ENVIRONMENT=production \
    RUST_LOG=warn \
    WHATSAPP__BROWSER__HEADLESS=true \
    WHATSAPP__BROWSER__ARGS="--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage"

# Command to run
CMD ["whatsapp-server"]
